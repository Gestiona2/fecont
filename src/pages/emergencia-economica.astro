---
/**
 * Landing: emergencia económica por el terremoto de agosto de 2026.
 *
 * Pieza de demostración para la propuesta de FECONT: muestra el tipo de
 * contenido oportuno que su sitio podría publicar para los asociados.
 * Lleva aviso visible de demostración y aviso legal.
 *
 * Todo el texto vive en src/datos/emergencia-economica.json, con sus fuentes.
 * Regla de esta página: si un dato no está verificado, se dice que está
 * pendiente. No se inventa ni se redondea hacia lo que "suena bien".
 */
import Layout from "../layouts/Layout.astro";
import CintaHero from "../components/CintaHero.astro";
import e from "../datos/emergencia-economica.json";
import { ruta } from "../lib/ruta";

const { hero, clave, contexto, linea, decretos, contador, comparativo, vigilar, cierre, fuentes } = e;

// El comparativo se muestra como tres tarjetas (una por emergencia), no como
// tabla: en celular y con el texto ampliado, una tabla de cuatro columnas no cabe.
const emergencias = comparativo.columnas.slice(1).map((nombre, i) => ({
  nombre,
  estado: comparativo.estados[i],
  filas: comparativo.filas.map((f) => ({ rotulo: f.rotulo, valor: f.valores[i] })),
}));
const etiquetaEstado = { caida: "Sin efectos", condicionada: "Avalada con límites", vigente: "Vigente" };
---

<Layout titulo={e.meta.titulo} descripcion={e.meta.descripcion} activa="noticias">
  <!-- ==================== PORTADA ==================== -->
  <section class="hero hero-interna">
    <CintaHero />
    <div class="container">
      <p class="aviso-demo em-aviso reveal"><i data-lucide="info"></i>{e.avisoDemo}</p>
      <span class="eyebrow reveal"><span class="dot"></span>{hero.eyebrow}</span>
      <h1 class="reveal">
        {hero.titulo}
        <span class="grad">{hero.tituloAcento}</span>
      </h1>
      <p class="lead reveal">{hero.bajada}</p>
      <p class="em-actualizado reveal">
        <i data-lucide="calendar-clock"></i>
        Actualizado el <time datetime={e.actualizadoISO}>{e.actualizado}</time>
      </p>

      <div class="em-datos reveal" data-stagger>
        {hero.datos.map((d) => (
          <div class="em-dato">
            <p class="v num">{d.valor}</p>
            <p class="t">{d.etiqueta}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== LO PRIMERO ==================== -->
  <section class="pad-sm">
    <div class="container">
      <div class="em-clave reveal">
        <span class="em-clave-ico"><i data-lucide="circle-check"></i></span>
        <div>
          <span class="eyebrow"><span class="dot"></span>{clave.etiqueta}</span>
          <h2>{clave.titulo}</h2>
          <p class="em-clave-texto">{clave.texto}</p>
          <p class="em-clave-matiz">{clave.matiz}</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="linea-marca" />

  <!-- ==================== QUÉ PASÓ ==================== -->
  <section class="pad zona-clara">
    <div class="container em-contexto">
      <div class="reveal">
        <span class="eyebrow"><span class="dot"></span>{contexto.titulo}</span>
        <p class="em-contexto-texto">{contexto.texto}</p>
      </div>
      <div>
        <div class="em-cifras" data-stagger>
          {contexto.cifras.map((c) => (
            <div class="em-cifra reveal-up">
              <p class="v num">{c.valor}</p>
              <p class="t">{c.etiqueta}</p>
            </div>
          ))}
        </div>
        <p class="em-nota reveal">{contexto.notaCifras}</p>
      </div>
    </div>
  </section>

  <!-- ==================== LÍNEA DE TIEMPO ==================== -->
  <section class="pad">
    <div class="container">
      <div class="cabecera-seccion reveal">
        <span class="eyebrow"><span class="dot"></span>Cronología</span>
        <h2 class="section-title">{linea.titulo}</h2>
      </div>

      <ol class="em-linea" data-stagger>
        {linea.hitos.map((h) => (
          <li class={`em-hito reveal-up estado-${h.estado}`}>
            <span class="em-hito-punto" aria-hidden="true"></span>
            <div class="em-hito-cuerpo">
              <p class="em-hito-fecha">{h.fecha}</p>
              <h3>{h.titulo}</h3>
              <p>{h.texto}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <hr class="linea-marca" />

  <!-- ==================== LOS 11 DECRETOS ==================== -->
  <section class="pad zona-clara" id="decretos">
    <div class="container">
      <div class="cabecera-seccion reveal">
        <span class="eyebrow"><span class="dot"></span>Decretos legislativos</span>
        <h2 class="section-title">{decretos.titulo}</h2>
        <p class="lead" style="margin-top:20px">{decretos.bajada}</p>
      </div>

      <div class="em-filtros reveal" role="group" aria-label="Filtrar decretos por tema">
        {decretos.temas.map((t, i) => (
          <button
            type="button"
            class={`em-filtro${i === 0 ? " activo" : ""}`}
            data-tema={t.id}
            aria-pressed={i === 0 ? "true" : "false"}
          >{t.nombre}</button>
        ))}
      </div>
      <p class="sr-only" id="emConteo" aria-live="polite"></p>

      <div class="em-decretos" id="emDecretos">
        {decretos.items.map((d) => (
          <article class={`em-decreto${d.destacado ? " destacado" : ""}`} data-tema={d.tema}>
            <div class="em-decreto-cab">
              <span class="em-num num">Decreto {d.numero}</span>
              {d.destacado && <span class="em-tag">Clave para contadores</span>}
            </div>
            <h3>{d.titulo}</h3>
            <p class="em-hace">{d.hace}</p>
            <p class="em-sirve"><strong>A quién le sirve:</strong> {d.leSirve}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== PARA EL CONTADOR ==================== -->
  <section class="pad" id="contador">
    <div class="container">
      <div class="cabecera-seccion reveal">
        <span class="eyebrow"><span class="dot"></span>{contador.eyebrow}</span>
        <h2 class="section-title">{contador.titulo}</h2>
      </div>

      <div class="em-bloques" data-stagger>
        {contador.bloques.map((b) => (
          <article class="em-bloque reveal-up">
            <span class="em-bloque-ico"><i data-lucide={b.icono}></i></span>
            <p class="em-num num">{b.decreto}</p>
            <h3>{b.titulo}</h3>
            <ul>
              {b.puntos.map((p) => <li>{p}</li>)}
            </ul>
            <p class="em-pendiente">
              <i data-lucide="triangle-alert"></i><span>{b.pendiente}</span>
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <hr class="linea-marca" />

  <!-- ==================== TRES EMERGENCIAS ==================== -->
  <section class="pad zona-clara">
    <div class="container">
      <div class="cabecera-seccion reveal">
        <span class="eyebrow"><span class="dot"></span>Contexto</span>
        <h2 class="section-title">{comparativo.titulo}</h2>
        <p class="lead" style="margin-top:20px">{comparativo.bajada}</p>
      </div>

      <div class="em-tres" data-stagger>
        {emergencias.map((m) => (
          <article class={`em-emergencia reveal-up estado-${m.estado}`}>
            <div class="em-emergencia-cab">
              <h3>{m.nombre}</h3>
              <span class="em-estado">{etiquetaEstado[m.estado]}</span>
            </div>
            <dl>
              {m.filas.map((f) => (
                <div class="em-fila">
                  <dt>{f.rotulo}</dt>
                  <dd>{f.valor}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== QUÉ VIGILAR ==================== -->
  <section class="pad">
    <div class="container">
      <div class="cabecera-seccion reveal">
        <span class="eyebrow"><span class="dot"></span>Seguimiento</span>
        <h2 class="section-title">{vigilar.titulo}</h2>
      </div>
      <div class="em-vigilar" data-stagger>
        {vigilar.items.map((v) => (
          <div class="em-vigilar-item reveal-up">
            <span class="ico"><i data-lucide={v.icono}></i></span>
            <h3>{v.titulo}</h3>
            <p>{v.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <hr class="linea-marca" />

  <!-- ==================== FUENTES ==================== -->
  <section class="pad-sm zona-clara" id="fuentes">
    <div class="container">
      <div class="cabecera-seccion reveal" style="margin-bottom:36px">
        <span class="eyebrow"><span class="dot"></span>Respaldo</span>
        <h2 class="section-title">{fuentes.titulo}</h2>
        <p class="lead" style="margin-top:16px">{fuentes.bajada}</p>
      </div>
      <ol class="em-fuentes">
        {fuentes.items.map((f) => (
          <li>
            <a href={f.url} target="_blank" rel="noopener">
              <span class="em-medio">{f.medio}</span>
              <span class="em-fuente-titulo">{f.titulo}</span>
              <i data-lucide="external-link"></i>
            </a>
          </li>
        ))}
      </ol>
      <p class="em-legal"><i data-lucide="triangle-alert"></i><span>{e.avisoLegal}</span></p>
    </div>
  </section>

  <!-- ==================== CIERRE ==================== -->
  <section class="pad cierre">
    <div class="container">
      <h2 class="reveal">
        {cierre.titulo}
        <span class="grad">{cierre.tituloAcento}</span>
      </h2>
      <p class="lead reveal">{cierre.bajada}</p>
      <div class="cierre-ctas reveal">
        <a href={cierre.ctaPrimario.href} class="btn btn-primary" target="_blank" rel="noopener">
          <i data-lucide="message-circle"></i>{cierre.ctaPrimario.texto}
        </a>
        <a href={ruta(cierre.ctaSecundario.href)} class="btn btn-ghost">{cierre.ctaSecundario.texto}</a>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  /* ---------- Filtro de decretos por tema ---------- */
  (function () {
    const botones = document.querySelectorAll(".em-filtro");
    const tarjetas = document.querySelectorAll(".em-decreto");
    const conteo = document.getElementById("emConteo");
    botones.forEach((b) => {
      b.addEventListener("click", () => {
        const tema = b.dataset.tema;
        botones.forEach((o) => {
          o.classList.toggle("activo", o === b);
          o.setAttribute("aria-pressed", String(o === b));
        });
        let visibles = 0;
        tarjetas.forEach((t) => {
          const mostrar = tema === "todos" || t.dataset.tema === tema;
          t.hidden = !mostrar;
          if (mostrar) visibles++;
        });
        if (conteo) conteo.textContent = visibles + (visibles === 1 ? " decreto" : " decretos");
      });
    });
  })();
</script>

<style>
  /* Portada más corta que la del home: aquí manda el contenido. */
  .hero-interna { min-height: auto; padding: 150px 0 70px; }
  .hero-interna h1 { font-size: clamp(2.3rem, 5.4vw, 4.3rem); max-width: 18ch; }
  .em-aviso { margin-bottom: 26px; }
  .em-actualizado {
    display: inline-flex; align-items: center; gap: 8px; margin-top: 22px;
    font-size: 0.86rem; font-weight: 700; color: var(--turquesa);
  }
  .em-actualizado :global(svg), .em-actualizado :global(i) { width: 16px; height: 16px; }

  .em-datos {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 48px;
    border-top: 1px solid rgba(238, 233, 220, 0.16); padding-top: 26px;
  }
  .em-datos > * { min-width: 0; }
  .em-dato .v {
    font-family: var(--font-display); font-weight: 900; line-height: 1;
    font-size: clamp(1.9rem, 4vw, 2.9rem);
    background: var(--grad-marca); -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
  }
  .em-dato .t { margin-top: 8px; font-size: 0.84rem; color: var(--text-muted); line-height: 1.4; }

  /* ---------- Lo primero ---------- */
  .em-clave {
    display: grid; grid-template-columns: auto 1fr; gap: 26px; align-items: start;
    padding: 40px; border-radius: 26px; position: relative; overflow: hidden;
    background: linear-gradient(150deg, #10294a 0%, #0b1523 100%);
    border: 1px solid rgba(0, 186, 194, 0.35);
    box-shadow: 0 30px 80px rgba(3, 8, 16, 0.5);
  }
  .em-clave::before {
    content: ""; position: absolute; top: -50%; right: -15%; width: 420px; height: 420px;
    border-radius: 50%; background: var(--grad-suave); filter: blur(90px); opacity: 0.35;
    pointer-events: none;
  }
  .em-clave > * { position: relative; z-index: 1; min-width: 0; }
  .em-clave-ico {
    width: 58px; height: 58px; border-radius: 16px; display: grid; place-items: center;
    background: var(--turquesa); color: var(--noche);
  }
  .em-clave-ico :global(svg), .em-clave-ico :global(i) { width: 30px; height: 30px; }
  .em-clave h2 { font-size: clamp(1.8rem, 4vw, 2.9rem); }
  .em-clave-texto { margin-top: 16px; font-size: 1.08rem; color: var(--text-soft); max-width: 66ch; }
  .em-clave-matiz {
    margin-top: 16px; padding-top: 16px; border-top: 1px solid rgba(238, 233, 220, 0.14);
    font-size: 0.94rem; color: var(--text-muted); max-width: 66ch;
  }

  /* ---------- Qué pasó ---------- */
  .em-contexto { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .em-contexto > * { min-width: 0; }
  .em-contexto-texto { font-size: clamp(1.1rem, 1.9vw, 1.35rem); line-height: 1.6; color: var(--text); }
  .em-cifras { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .em-cifras > * { min-width: 0; }
  .em-cifra {
    padding: 22px 18px; border-radius: 18px; background: var(--surface); border: 1px solid var(--border);
  }
  .em-cifra .v {
    font-family: var(--font-display); font-weight: 900; font-size: clamp(1.4rem, 2.6vw, 2rem);
    color: var(--noche); line-height: 1;
  }
  .em-cifra .t { margin-top: 8px; font-size: 0.8rem; color: var(--text-muted); }
  .em-nota { margin-top: 14px; font-size: 0.78rem; color: var(--text-muted); line-height: 1.5; }

  /* ---------- Línea de tiempo ---------- */
  .em-linea { list-style: none; position: relative; max-width: 820px; }
  .em-linea::before {
    content: ""; position: absolute; left: 11px; top: 8px; bottom: 8px; width: 2px;
    background: linear-gradient(to bottom, var(--turquesa), var(--azul) 45%, var(--magenta) 75%, rgba(246,117,12,0.3));
  }
  .em-hito { position: relative; padding: 0 0 34px 48px; }
  .em-hito:last-child { padding-bottom: 0; }
  .em-hito-punto {
    position: absolute; left: 3px; top: 4px; width: 18px; height: 18px; border-radius: 50%;
    background: var(--noche); border: 3px solid var(--turquesa);
  }
  .estado-proximo .em-hito-punto { border-color: var(--naranja); box-shadow: 0 0 0 5px rgba(246,117,12,0.18); }
  .estado-pendiente .em-hito-punto { border-color: rgba(238,233,220,0.4); border-style: dashed; }
  .em-hito-fecha {
    font-family: var(--font-display); font-size: 0.78rem; font-weight: 800;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--turquesa);
  }
  .estado-proximo .em-hito-fecha { color: var(--naranja); }
  .estado-pendiente .em-hito-fecha { color: var(--text-muted); }
  .em-hito h3 { font-size: 1.2rem; margin-top: 4px; }
  .em-hito p:last-child { margin-top: 6px; font-size: 0.94rem; color: var(--text-soft); }

  /* ---------- Decretos ---------- */
  .em-filtros { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 30px; }
  .em-filtro {
    padding: 9px 17px; border-radius: 999px; font-family: var(--font-display);
    font-weight: 700; font-size: 0.85rem; border: 1px solid var(--border-fuerte); color: var(--text-soft);
    transition: all 0.25s ease;
  }
  .em-filtro:hover { border-color: var(--azul); color: var(--azul); }
  .em-filtro.activo { background: var(--noche); border-color: var(--noche); color: var(--hueso); }

  .em-decretos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .em-decretos > * { min-width: 0; }
  .em-decreto {
    padding: 26px; border-radius: 20px; background: var(--surface); border: 1px solid var(--border);
    display: flex; flex-direction: column;
    transition: transform 0.3s cubic-bezier(.2,.7,.2,1), box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .em-decreto:hover { transform: translateY(-4px); box-shadow: 0 18px 44px var(--sombra); }
  /* display:flex le gana al [hidden] del navegador: sin esta regla el filtro
     no ocultaría ninguna tarjeta. */
  .em-decreto[hidden] { display: none; }
  .em-decreto.destacado { border: 2px solid var(--azul); }
  .em-decreto-cab { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }
  .em-num {
    font-family: var(--font-display); font-weight: 800; font-size: 0.8rem;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--acento-texto);
  }
  .em-tag {
    font-size: 0.68rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase;
    padding: 4px 10px; border-radius: 999px; background: var(--azul); color: #fff;
  }
  .em-decreto h3 { font-size: 1.15rem; margin-top: 12px; }
  .em-hace { margin-top: 10px; font-size: 0.9rem; color: var(--text-soft); flex: 1; }
  .em-sirve {
    margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--border);
    font-size: 0.84rem; color: var(--text-muted);
  }
  .em-sirve strong { color: var(--text); }

  /* ---------- Para el contador ---------- */
  .em-bloques { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .em-bloques > * { min-width: 0; }
  .em-bloque {
    padding: 30px; border-radius: 22px; background: var(--surface); border: 1px solid var(--border);
    display: flex; flex-direction: column;
  }
  .em-bloque-ico {
    width: 46px; height: 46px; border-radius: 13px; display: grid; place-items: center;
    background: var(--grad-suave); color: #fff; margin-bottom: 18px;
  }
  .em-bloque-ico :global(svg), .em-bloque-ico :global(i) { width: 23px; height: 23px; }
  .em-bloque h3 { font-size: 1.25rem; margin-top: 6px; }
  /* flex:1 empuja el aviso de "pendiente" al pie de cada tarjeta; align-content:start
     evita que la retícula reparta esa altura sobrante entre las viñetas. */
  .em-bloque ul {
    margin-top: 16px; padding-left: 0; list-style: none;
    display: grid; gap: 10px; flex: 1; align-content: start;
  }
  .em-bloque li {
    position: relative; padding-left: 20px; font-size: 0.9rem; color: var(--text-soft); line-height: 1.55;
  }
  .em-bloque li::before {
    content: ""; position: absolute; left: 0; top: 0.62em; width: 8px; height: 8px;
    border-radius: 50%; background: var(--turquesa);
  }
  .em-pendiente {
    margin-top: 20px; display: flex; gap: 10px; align-items: flex-start;
    padding: 14px; border-radius: 14px; font-size: 0.82rem; line-height: 1.5;
    background: rgba(246, 117, 12, 0.1); border: 1px solid rgba(246, 117, 12, 0.3); color: #f9c39a;
  }
  .em-pendiente :global(svg), .em-pendiente :global(i) {
    width: 17px; height: 17px; flex-shrink: 0; margin-top: 1px; color: var(--naranja);
  }

  /* ---------- Tres emergencias ---------- */
  .em-tres { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .em-tres > * { min-width: 0; }
  .em-emergencia {
    border-radius: 22px; background: var(--surface); border: 1px solid var(--border); overflow: hidden;
  }
  .em-emergencia.estado-vigente { border: 2px solid var(--azul); }
  .em-emergencia-cab {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px;
    padding: 20px 22px; background: var(--surface-2); border-bottom: 1px solid var(--border);
  }
  .em-emergencia-cab h3 { font-size: 1.15rem; }
  .em-estado {
    font-size: 0.7rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase;
    padding: 5px 11px; border-radius: 999px;
  }
  .estado-caida .em-estado { background: rgba(180, 26, 59, 0.12); color: var(--magenta); }
  .estado-condicionada .em-estado { background: rgba(246, 117, 12, 0.14); color: #b8560a; }
  .estado-vigente .em-estado { background: var(--azul); color: #fff; }
  .em-emergencia dl { padding: 8px 22px 18px; }
  .em-fila { padding: 12px 0; border-bottom: 1px solid var(--border); }
  .em-fila:last-child { border-bottom: 0; }
  .em-fila dt {
    font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted);
  }
  .em-fila dd { margin-top: 3px; font-size: 0.92rem; color: var(--text); }

  /* ---------- Qué vigilar ---------- */
  .em-vigilar { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .em-vigilar > * { min-width: 0; }
  .em-vigilar-item { padding: 26px; border-radius: 20px; background: var(--surface); border: 1px solid var(--border); }
  .em-vigilar-item .ico {
    width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center;
    background: rgba(0, 186, 194, 0.14); color: var(--turquesa); margin-bottom: 16px;
  }
